{
  "name": "intern-pilot-electron",
  "version": "1.0.0",
  "private": true,
  "description": "实习领航 求职中台 的 Electron 桌面封装配置",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.internpilot.app",
    "productName": "实习领航",
    "files": ["main.js", "out/**/*"],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
